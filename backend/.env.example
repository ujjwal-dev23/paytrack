# --- Server Configuration ---
PORT=3000
# Comma-separated list of allowed origins for CORS
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# --- Database ---
# Path to SQLite database file. Leave empty to use 'data.db' in the backend root.
DB_PATH=

# --- Security & Auth ---
# Secret key for signing JWT tokens. Change this to a long random string in production.
JWT_SECRET=super-secret-key-change-me-in-production
# JWT token expiration time (e.g., '1d', '7d')
JWT_EXPIRES_IN=7d
# Secret for signing cookies
COOKIE_SECRET=munch-munch

# --- Frontend Integration ---
# URL of the backend API (used for email interpolation or frontend redirects if needed)
VITE_API_URL=http://127.0.0.1:3000/api

# --- Email Service (Resend) ---
# Your Resend API Key (found at https://resend.com/api-keys)
RESEND_API_KEY=re_your_api_key
# The verified sender email address. Use 'onboarding@resend.dev' for initial testing.
RESEND_FROM_EMAIL=onboarding@resend.dev
